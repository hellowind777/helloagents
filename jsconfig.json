{
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["cli.mjs", "src/**/*.mjs", "tests/**/*.mjs"]
}
