{
  "name": "helloagents",
  "version": "4.0.6",
  "type": "module",
  "description": "HelloAGENTS — AI 编码 CLI 的思维激活层：纠偏内核 + 按需思维技能，一条命令分发到 Claude Code、Codex CLI、Grok Build、Cursor、Hermes、DeepSeek Harness。A thinking-activation layer for AI coding CLIs.",
  "author": "HelloWind",
  "license": "Apache-2.0",
  "homepage": "https://github.com/hellowind777/helloagents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hellowind777/helloagents.git"
  },
  "bin": {
    "helloagents": "cli.mjs",
    "helloagents-js": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "src/",
    "prompts/",
    "skills/",
    "hooks/",
    "assets/",
    "dsh/",
    ".claude-plugin/",
    ".cursor-plugin/",
    ".codex-plugin/",
    "README.md",
    "README_CN.md",
    "LICENSE.md"
  ],
  "exports": {
    "./dsh": "./dsh/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "typecheck": "tsc -p jsconfig.json",
    "sync-version": "node cli.mjs sync-version",
    "verify": "npm run test"
  },
  "keywords": [
    "ai",
    "agent",
    "claude",
    "codex",
    "grok",
    "cursor",
    "hermes",
    "deepseek",
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cli",
    "skills",
    "prompt"
  ],
  "engines": {
    "node": ">=20.19.0"
  }
}
